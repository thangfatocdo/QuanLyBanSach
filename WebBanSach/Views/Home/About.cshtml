@{
    ViewData["Title"] = "Về chúng tôi";
}
<!-- Breadcumb Section Start -->
<div class="breadcrumb-wrapper">
    <div class="book1">
        <img src="~/assets/img/book.png" alt="book">
    </div>
    <div class="book2">
        <img src="~/assets/img/hero/book2.png" alt="book">
    </div>
    <div class="container">
        <div class="page-heading">
            <h1>Về chúng tôi</h1>
            <div class="page-header">
                <ul class="breadcrumb-items wow fadeInUp" data-wow-delay=".3s">
                    <li>
                        <a href="/">
                            Trang chủ
                        </a>
                    </li>
                    <li>
                        <i class="fa-solid fa-chevron-right"></i>
                    </li>
                    <li>
                        Về chúng tôi
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- About Section Start -->
<section class="about-section fix section-padding">
    <div class="container">
        <div class="about-wrapper">
            <div class="row g-4 align-items-center">
                <div class="col-lg-6 wow fadeInUp" data-wow-delay=".3s">
                    <div class="about-image">
                        <img src="~/assets/img/rick.jpg" alt="img">
                        <div class="video-box">
                            <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ"
                               class="video-btn ripple video-popup">
                                <i class="fa-solid fa-play"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="about-content">
                        <div class="section-title">
                            <h2 class="wow fadeInUp" data-wow-delay=".3s">Về nhà sách Hải Đăng</h2>
                        </div>
                        <p class="mt-3 mt-md-0 wow fadeInUp" data-wow-delay=".5s">
                             Chào bạn, mình tên Đỗ Hữu Thắng, mình là một sinh viên năm cuối ngành Công nghệ Thông tin, hiện đang hoàn thiện đồ án tốt nghiệp với sản phẩm là một hệ thống quản lý nhà sách tích hợp cả Web, Winform, Mobile và AI. Dù từng có giai đoạn tạm rời xa lập trình để làm sales phòng trọ, nhưng mình vẫn chọn quay lại với IT vì đó là con đường học tập chính và cũng là nơi mình muốn phát triển lâu dài.
                        </p>
                        <p class="mt-3 wow fadeInUp" data-wow-delay=".7s">
                           Mình thích sự hài hước, tò mò với lịch sử và ngôn ngữ học, và đôi khi dành thời gian chơi Genshin Impact để chill một chút. Mình tin rằng mỗi dòng code viết ra không chỉ để máy hiểu, mà còn là cách thể hiện tư duy và cá tính của người viết. Trang web này là một phần hành trình đó, rất vui vì bạn đã ghé thăm!
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
