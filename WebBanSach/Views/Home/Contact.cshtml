<!-- Contact Section Start -->
<section class="contact-section fix section-padding">
    <div class="container">
        <div class="contact-wrapper">
            <div class="row g-4 align-items-center">
                <div class="col-lg-4">
                    <div class="contact-left-items">
                        <div class="contact-info-area-2">
                            <div class="contact-info-items mb-4">
                                <div class="icon">
                                    <i class="icon-icon-10"></i>
                                </div>
                                <div class="content">
                                    <p>Gọi ngay</p>
                                    <h3>
                                        <a href="tel:+2085550112">0352037252</a>
                                    </h3>
                                </div>
                            </div>
                            <div class="contact-info-items mb-4">
                                <div class="icon">
                                    <i class="icon-icon-11"></i>
                                </div>
                                <div class="content">
                                    <p>Make a Quote</p>
                                    <h3>
                                        <a href="mailto:yendaotg@gmail.com">yendaotg@gmail.com</a>
                                    </h3>
                                </div>
                            </div>
                            <div class="contact-info-items border-none">
                                <div class="icon">
                                    <i class="icon-icon-12"></i>
                                </div>
                                <div class="content">
                                    <p>Location</p>
                                    <h3>
                                        TP Hồ Chí Minh.
                                    </h3>
                                </div>
                            </div>
                        </div>
                        <div class="video-image">
                            <img src="~/assets/img/rick.jpg" alt="img">
                            <div class="video-box">
                                <a href="https://www.youtube.com/watch?v=Cn4G2lZ_g2I"
                                   class="video-btn ripple video-popup">
                                    <i class="fa-solid fa-play"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                   
                </div>
            </div>
        </div>
    </div>
</section>

