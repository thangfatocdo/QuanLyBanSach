<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:charts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="Doan1.views.HomePage"
             Title="Trang chủ"
             BackgroundColor="White">
    <RefreshView
    IsRefreshing="{Binding IsRefreshing}"
    Command="{Binding RefreshCommand}"
    RefreshColor="#3498db">
        <!-- Top Section -->
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Dropdown -->
            <Grid>
                <!-- Ngày -->
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Chọn ngày:" 
                   VerticalOptions="Center"
                   FontSize="14"
                   FontAttributes="Bold" />
                    <DatePicker Date="{Binding SelectedDate}" 
                Format="dd/MM/yyyy"
                HorizontalOptions="StartAndExpand"
                FontSize="14" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Thống kê -->
            <Frame Padding="15" CornerRadius="15" HasShadow="False" BorderColor="#ddd">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto">
                        <VerticalStackLayout>
                            <Label Text="{Binding TotalOrderCount, StringFormat='{}{0} hóa đơn'}" FontSize="12"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding UncompletedOrderCount, StringFormat='{}{0} đơn chưa hoàn thành'}" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#e0e0e0" />
                </VerticalStackLayout>
            </Frame>

                <!-- Top sách bán chạy -->
                <Frame Padding="10" CornerRadius="15" BackgroundColor="White" HasShadow="False">
                    <VerticalStackLayout>
                        <Label Text="📚 Top sách bán chạy tuần này" FontSize="14" FontAttributes="Bold" />

                        <CollectionView ItemsSource="{Binding TopBooks}" 
                        HeightRequest="180"
                        ItemsLayout="HorizontalList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <StackLayout WidthRequest="120" Margin="10,10,0,0">
                                        <Image Source="{Binding ImageUrl}" 
                                           WidthRequest="90"
                                           HeightRequest="130"
                                           Aspect="AspectFill"
                                           Margin="0,0,0,5"/>
                                        <Label Text="{Binding Title}" 
                               FontSize="12" 
                               LineBreakMode="TailTruncation"
                               MaxLines="2" />
                                        <Label Text="{Binding TotalSold, StringFormat='Đã bán: {0}'}"
                               FontSize="11"
                               TextColor="Gray" />
                                    </StackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>


                <!-- Doanh thu -->
            <Frame Padding="15" CornerRadius="20" HasShadow="False" BackgroundColor="#FAFAFA">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Doanh Thu" FontSize="16" FontAttributes="Bold"/>
                        <Image Source="arrow_right.png" WidthRequest="18" HeightRequest="18"/>
                    </Grid>

                    <!-- Tabs -->
                    <HorizontalStackLayout Spacing="10" Margin="0,10">
                            <Button Text="Tuần" CommandParameter="Week" 
                                    FontSize="12"
                                    TextColor="#007AFF"
                                    BackgroundColor="#D9F1FF"
                                    CornerRadius="10"
                                    Padding="10,4"
                                    HeightRequest="30"
                                    Clicked="OnTabClicked"/>
                            <Button Text="Tháng" CommandParameter="Month"
                                    FontSize="12"
                                    TextColor="Gray"
                                    BackgroundColor="Transparent"
                                    Padding="10,4"
                                    HeightRequest="30"
                                    Clicked="OnTabClicked"/>
                            <Button Text="Năm" CommandParameter="Year"
                                    FontSize="12"
                                    TextColor="Gray"
                                    BackgroundColor="Transparent"
                                    Padding="10,4"
                                    HeightRequest="30"
                                    Clicked="OnTabClicked"/>
                    </HorizontalStackLayout>

                    <!-- Biểu đồ -->
                    <charts:ChartView HeightRequest="200"
                                          Chart="{Binding RevenueChart}" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
    </RefreshView>
</ContentPage>