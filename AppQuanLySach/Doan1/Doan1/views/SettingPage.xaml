<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Doan1.views.SettingPage"
             BackgroundColor="#FAFAFA">

    <VerticalStackLayout Padding="0" Spacing="0">

        <!-- Header người dùng -->
        <Frame BackgroundColor="#FB5E2E"
               CornerRadius="0"
               Padding="20"
               HasShadow="False">

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15" VerticalOptions="Center">

                <!-- ẢNH ĐẠI DIỆN -->
                <Frame WidthRequest="48"
               HeightRequest="48"
               Padding="0"
               CornerRadius="24"
               IsClippedToBounds="True"
               HasShadow="False"
               BackgroundColor="White"
               VerticalOptions="Center">
                    <Image Source="{Binding ImageUrl}"
                   Aspect="AspectFill"
                   WidthRequest="48"
                   HeightRequest="48" />
                </Frame>


                <!-- Tên user -->
                <Label Text="{Binding FullName}"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="White"
               VerticalOptions="Center"
               Grid.Column="1" />
                <!-- Nút logout -->
                <Button Text="Log out"
                Clicked="OnLogoutClicked"
                BorderColor="White"
                BorderWidth="2"
                TextColor="White"
                BackgroundColor="Transparent"
                CornerRadius="20"
                Padding="12,4"
                HorizontalOptions="End"
                VerticalOptions="Center"
                Grid.Column="2" />
            </Grid>
        </Frame>

        <!-- Các nội dung khác -->
        <!-- ... -->

    </VerticalStackLayout>
</ContentPage>
