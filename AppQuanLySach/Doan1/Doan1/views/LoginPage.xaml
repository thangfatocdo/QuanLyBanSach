<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Doan1.views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="White">

    <VerticalStackLayout Padding="30" Spacing="20">
        <Label Text="Đăng nhập" FontSize="24" HorizontalOptions="Center" />
        <Entry x:Name="txtUsername" Placeholder="Tên đăng nhập" />
        <Entry x:Name="txtPassword" Placeholder="Mật khẩu" IsPassword="True" />
        <Button Text="Đăng nhập" Clicked="OnLoginClicked" />
    </VerticalStackLayout>
</ContentPage>
