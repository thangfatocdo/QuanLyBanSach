<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Doan1.Converters"
    x:Name="ThisPage"
    x:Class="Doan1.views.BillPage"
    BackgroundColor="#F0F0F0"
    Title="Danh sách đơn hàng">
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Tổng tiền và số lượng đơn -->
        <Frame
            Grid.Row="0"
            BackgroundColor="White"
            CornerRadius="20"
            Padding="15"
            HasShadow="False"
            Margin="15,10,15,0">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10">

                <!-- Icon -->
                <Image Source="menu.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       VerticalOptions="Center"
                       Grid.RowSpan="2" />

                <!-- Tiêu đề "Tổng tiền hàng" -->
                <Label Text="Tổng tiền hàng"
                       FontAttributes="Bold"
                       FontSize="16"
                       VerticalOptions="Center"
                       Grid.Column="1" />

                <!-- Số tiền tổng -->
                <Label Text="{Binding TotalAmount, StringFormat='{0:N0} đ'}"
                       FontAttributes="Bold"
                       FontSize="16"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       Grid.Column="2" />

                <!-- Số lượng hóa đơn -->
                <Label Text="{Binding BillCount, StringFormat='{}{0} Đơn hàng'}"
                       FontSize="12"
                       TextColor="Gray"
                       Grid.Row="1"
                       Grid.Column="1" />
            </Grid>
        </Frame>
        <!-- Bộ chọn ngày -->
        <HorizontalStackLayout
    Grid.Row="1"
    Padding="20,10,20,0"
    Spacing="10"
    BackgroundColor="White">
            <Label Text="Chọn ngày:"
           FontSize="14"
           VerticalOptions="Center"
           FontAttributes="Bold" />
            <DatePicker Date="{Binding SelectedDate}" 
                Format="dd/MM/yyyy"
                HorizontalOptions="StartAndExpand" />
        </HorizontalStackLayout>
        <!-- Danh sách hóa đơn -->
        <Frame
            Grid.Row="2"
            BackgroundColor="White"
            CornerRadius="20"
            Padding="15"
            HasShadow="False"
            Margin="0,30,0,0">
            <RefreshView
IsRefreshing="{Binding IsRefreshing}"
Command="{Binding RefreshCommand}"
RefreshColor="#3498db">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <ActivityIndicator 
                    IsRunning="{Binding IsLoading}" 
                    IsVisible="{Binding IsLoading}" 
                    HorizontalOptions="Center" 
                    VerticalOptions="Center" 
                    Color="Gray"
                    HeightRequest="50" WidthRequest="50"
                    Margin="0,20,0,0"/>

                        <Label
                    Text="Chưa có đơn nào"
                    TextColor="Gray"
                    FontAttributes="Italic"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0"
                    IsVisible="{Binding Bills.Count, Converter={StaticResource ZeroToVisibleConverter}}" />
                        <!-- CollectionView hiển thị đơn hàng -->
                        <CollectionView
                    ItemsSource="{Binding Bills}"
                    SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame
                                Margin="0,0,0,10"
                                Padding="12"
                                CornerRadius="12"
                                BackgroundColor="#FFFFFF"
                                HasShadow="True">
                                        <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="10">

                                            <!-- Mã đơn & ngày đặt (dòng 1) -->
                                            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                                                <Label Text="{Binding BillId, StringFormat='#{0}'}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="Black" />
                                                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                               FontSize="12"
                                               TextColor="Gray" />
                                            </StackLayout>

                                            <!-- Trạng thái & tổng tiền (dòng 2) -->
                                            <StackLayout Grid.Row="1" Grid.Column="0" Orientation="Vertical" Margin="0,5,0,0">
                                                <!-- Bạn có thể bind Status nếu API trả về, ở đây để tạm "Hoàn thành" -->
                                                <Label Text="{Binding StatusName}"
       FontSize="12">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding StatusName}" Value="Đã hủy">
                                                            <Setter Property="TextColor" Value="Red" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding StatusName}" Value="Đang giao">
                                                            <Setter Property="TextColor" Value="#4CAF50" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding StatusName}" Value="Chờ duyệt">
                                                            <Setter Property="TextColor" Value="Orange" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding StatusName}" Value="Đã duyệt">
                                                            <Setter Property="TextColor" Value="#4CAF50" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding StatusName}" Value="Đã nhận">
                                                            <Setter Property="TextColor" Value="#4CAF50" />
                                                        </DataTrigger>
                                                        <!-- Có thể thêm trạng thái khác nếu cần -->
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="{Binding Amount, StringFormat='{0:N0} đ'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               Margin="0,3,0,0" />
                                            </StackLayout>

                                            <!-- Nút "Chi tiết" -->
                                            <Button
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Text="Chi tiết"
                                        BackgroundColor="#2196F3"
                                        TextColor="White"
                                        FontSize="12"
                                        CornerRadius="8"
                                        Padding="12,6"
                                        VerticalOptions="Center"
                                        Command="{Binding BindingContext.ShowDetailCommand, Source={x:Reference Name=ThisPage}}"
                                        CommandParameter="{Binding BillId}" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Frame>
    </Grid>

</ContentPage>
